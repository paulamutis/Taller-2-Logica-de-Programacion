Algoritmo area_de_un_rectangulo
	Definir base Como Entero
	Definir altura Como Entero
	Definir resultado_area Como Entero 
	Definir resultado_perimetro Como Entero  
	Escribir "ingresar base"
	Leer base 
	Escribir "ingresar altura"
	Leer altura
	resultado_area <- (base*altura)
	Escribir "el area es "
	Escribir resultado_area
	resultado_perimetro <- (base+altura)*2
	Escribir "el perimetro es"
	Escribir resultado_perimetro
	
FinAlgoritmo
